            const nameMatch = item.student.name.toLowerCase().includes(searchQuery);
            const mapelMatch = item.missed.some(m =>
              m.mapel.toLowerCase().includes(searchQuery) ||
              m.formattedLine.toLowerCase().includes(searchQuery)
