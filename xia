      document.getElementById('filter-search').value = '';
      document.getElementById('filter-student').value = 'all';
      document.getElementById('filter-pekan').value = 'all';
      document.getElementById('filter-sesi').value = 'all';
      document.getElementById('filter-status-mode').value = 'all';
