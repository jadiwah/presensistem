      e.preventDefault();
      const textarea = document.getElementById('bulk-student-names');
      const lines = textarea.value
        .split(/\r?\n/)
        .map(l => l.trim())
        .filter(Boolean);

      if (lines.length === 0) return;

      let addedCount = 0;
      lines.forEach((line, idx) => {
        // Mendukung format "Nama Siswa - 08123456" atau hanya "Nama Siswa"
        const parts = line.split(/\s+-\s+|\t|;/);
        const name = (parts[0] || '').trim();
        const phone = parts[1] ? normalizeIndonesianPhone(parts[1].trim()) : '';

        if (name) {
          appState.students.push({
            id: 'stu_' + (Date.now() + idx) + '_' + Math.random().toString(36).slice(2, 6),
            name,
            phone
          });
          addedCount++;
        }
      });

      textarea.value = '';
      saveState();
      renderSettingsTab();
      document.getElementById('nav-badge-students').textContent = appState.students.length;
      showToast(`${addedCount} anak wali berhasil ditambahkan sekaligus!`, 'success');
    }

    function setFocusedSubjectInput(inputEl) {
      focusedSubjectInput = inputEl;
    }

    function insertQuickSubject(subjectName) {
      const target = focusedSubjectInput || document.getElementById('tpl-2-sesi1');
      target.value = subjectName;
      target.focus();
    }

    function applyTemplatesToSchedule() {
      const newTemplates = {
        2: {
          sesi1: document.getElementById('tpl-2-sesi1').value.trim() || 'Sesi 1',
          sesi2: document.getElementById('tpl-2-sesi2').value.trim() || 'Sesi 2'
        },
        4: {
          sesi1: document.getElementById('tpl-4-sesi1').value.trim() || 'Sesi 1',
          sesi2: document.getElementById('tpl-4-sesi2').value.trim() || 'Sesi 2'
        },
        6: {
          sesi1: document.getElementById('tpl-6-sesi1').value.trim() || 'Sesi 1',
          sesi2: document.getElementById('tpl-6-sesi2').value.trim() || 'Sesi 2'
        }
      };

      const overrideCount = Object.keys(appState.scheduleOverrides || {}).length;

      if (overrideCount > 0) {
        openModal({
          title: 'Terapkan Template Mapel',
          bodyHTML: `
            <p>Ditemukan <strong>${overrideCount} tanggal</strong> yang sebelumnya diubah secara khusus per tanggal.</p>
            <p class="text-xs text-slate-500">Pilih apakah perubahan khusus per tanggal tersebut tetap dipertahankan atau ditimpa seluruhnya oleh template baru:</p>
          `,
          actions: [
            {
              label: 'Pertahankan Perubahan Khusus',
              className: 'px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold',
              onClick: () => {
                appState.settings.templates = newTemplates;
                saveState();
                generateSchedule();
                renderSettingsTab();
                closeModal();
                showToast('Template diterapkan ke seluruh jadwal September–Desember!', 'success');
              }
            },
            {
              label: 'Timpa Semua Tanggal',
              className: 'px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold',
              onClick: () => {
                appState.settings.templates = newTemplates;
                appState.scheduleOverrides = {};
                saveState();
                generateSchedule();
                renderSettingsTab();
                closeModal();
                showToast('Semua jadwal September–Desember berhasil diperbarui!', 'success');
              }
            }
          ]
        });
      } else {
        appState.settings.templates = newTemplates;
        saveState();
        generateSchedule();
        renderSettingsTab();
        showToast('Template mapel diterapkan ke seluruh jadwal September–Desember!', 'success');
      }
    }

    function updatePeriodSettings() {
      const year = Number(document.getElementById('setting-year').value);
      const monthsCount = Number(document.getElementById('setting-months').value);
      appState.settings.year = year;
      appState.settings.monthsCount = monthsCount;
      saveState();
      generateSchedule();
      renderSettingsTab();
      showToast(`Periode jadwal diperbarui ke September ${year} (${monthsCount} bulan).`, 'success');
    }

