      const stu = appState.students.find(s => s.id === studentId);
      if (!stu) return;

      openModal({
        title: 'Edit Data Anak Wali',
        bodyHTML: `
          <div class="space-y-3">
            <div>
              <label for="edit-stu-name" class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap</label>
              <input type="text" id="edit-stu-name" value="${escapeHTML(stu.name)}"
                class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-xl focus:outline-none focus:border-indigo-500" />
            </div>
            <div>
              <label for="edit-stu-phone" class="block text-xs font-bold text-slate-700 mb-1">No. WhatsApp (Opsional)</label>
              <input type="text" id="edit-stu-phone" value="${escapeHTML(stu.phone || '')}" placeholder="081234567890"
                class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-xl focus:outline-none focus:border-indigo-500" />
            </div>
          </div>
        `,
        actions: [
          {
            label: 'Batal',
            className: 'px-3.5 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold',
            onClick: closeModal
          },
          {
            label: 'Simpan Perubahan',
            className: 'px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold',
            onClick: () => {
              const newName = document.getElementById('edit-stu-name').value.trim();
              const newPhone = normalizeIndonesianPhone(document.getElementById('edit-stu-phone').value.trim());
              if (!newName) {
                showToast('Nama siswa tidak boleh kosong.', 'error');
                return;
              }
              stu.name = newName;
              stu.phone = newPhone;
              saveState();
              renderSettingsTab();
              closeModal();
              showToast('Data anak wali berhasil diperbarui.', 'success');
            }
          }
        ]
      });
    }

    function promptDeleteStudent(studentId) {
      const stu = appState.students.find(s => s.id === studentId);
      if (!stu) return;

      openModal({
        title: 'Hapus Anak Wali?',
        bodyHTML: `
          <p>Anda yakin ingin menghapus <strong>${escapeHTML(stu.name)}</strong> dari daftar anak wali?</p>
          <p class="text-xs text-slate-500">Riwayat presensi milik siswa ini juga akan dihapus dari rekap.</p>
        `,
        actions: [
          {
            label: 'Batal',
            className: 'px-3.5 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold',
            onClick: closeModal
          },
          {
            label: 'Ya, Hapus',
            className: 'px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold',
            onClick: () => {
              appState.students = appState.students.filter(s => s.id !== studentId);
              Object.keys(appState.attendance).forEach(dateStr => {
                if (appState.attendance[dateStr]) {
                  delete appState.attendance[dateStr][studentId];
                }
              });
              saveState();
              renderSettingsTab();
              updateTopMissedBadgeOnly();
              document.getElementById('nav-badge-students').textContent = appState.students.length;
              closeModal();
              showToast(`"${stu.name}" berhasil dihapus.`, 'info');
            }
          }
        ]
      });
    }

    /**
     * Kosongkan Data Contoh & Reset Data
