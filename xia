 <!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Presensi Otomatis Anak Wali</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <style>
    /* Custom scrollbar & smooth transitions */
    body {
      background-color: #f8fafc;
      color: #0f172a;
      -webkit-tap-highlight-color: transparent;
    }
    .tab-active {
      background-color: #4f46e5;
      color: #ffffff;
      box-shadow: 0 4px 12px -2px rgba(79, 70, 229, 0.35);
    }
    .tab-inactive {
      color: #475569;
      background-color: transparent;
    }
    .tab-inactive:hover {
      background-color: #f1f5f9;
      color: #1e293b;
    }
    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-up {
      animation: fadeSlideUp 0.25s ease-out forwards;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-indigo-100 selection:text-indigo-900">

  <!-- ==================== HEADER & NAVIGASI UTAMA ==================== -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Baris Atas: Judul Aplikasi & Indikator Periode -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-3 gap-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-indigo-700 text-white flex items-center justify-center shadow-sm shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <div>
              <h1 class="font-display text-base sm:text-lg font-bold text-slate-900 leading-tight">
                Presensi Anak Wali
              </h1>
              <p id="header-period-subtitle" class="text-xs text-slate-500 font-medium">
                Jadwal Selasa, Kamis, Sabtu • Mulai Sep 2026
              </p>
            </div>
          </div>

          <!-- Status Tersimpan (Mobile) -->
          <span id="save-badge-mobile" class="sm:hidden inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Tersimpan
          </span>
        </div>

        <!-- Status Tersimpan & Info Jadwal (Desktop) -->
        <div class="hidden sm:flex items-center gap-3">
          <div id="header-schedule-pill" class="px-3 py-1.5 rounded-xl bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold">
            18 Pekan • 53 Pertemuan
          </div>
          <span id="save-badge-desktop" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Auto-Save Aktif
          </span>
        </div>
      </div>

      <!-- Baris Bawah: 3 Tab Utama (Mobile-Friendly) -->
      <nav aria-label="Navigasi Utama" class="grid grid-cols-3 gap-1.5 pb-3 pt-1">
        <button type="button" id="tab-btn-rekap" onclick="switchTab('rekap')"
          class="tab-active flex items-center justify-center gap-1.5 sm:gap-2 py-2.5 px-2 sm:px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <span class="truncate">Dashboard Rekap</span>
          <span id="nav-badge-missed" class="ml-0.5 px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-rose-500 text-white">0</span>
        </button>

        <button type="button" id="tab-btn-input" onclick="switchTab('input')"
          class="tab-inactive flex items-center justify-center gap-1.5 sm:gap-2 py-2.5 px-2 sm:px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span class="truncate">Input Presensi</span>
        </button>

        <button type="button" id="tab-btn-settings" onclick="switchTab('settings')"
          class="tab-inactive flex items-center justify-center gap-1.5 sm:gap-2 py-2.5 px-2 sm:px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span class="truncate">Input Wali & Mapel</span>
          <span id="nav-badge-students" class="hidden sm:inline-block ml-0.5 px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-slate-200 text-slate-700">0</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- ==================== KONTEN UTAMA ==================== -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-7 space-y-6">

    <!-- Banner Data Simulasi Awal (Hanya tampil jika isDemoData === true) -->
    <div id="demo-banner" class="hidden bg-gradient-to-r from-indigo-50 via-blue-50 to-indigo-50 border border-indigo-200 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm">
      <div class="flex items-start sm:items-center gap-3">
        <div class="p-2 rounded-xl bg-indigo-100 text-indigo-700 shrink-0 mt-0.5 sm:mt-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-bold text-indigo-950">Mode Data Contoh Simulasi Aktif</p>
          <p class="text-xs text-indigo-800/80 mt-0.5">
            Saat ini ditampilkan 5 contoh anak wali beserta simulasi ketidakhadiran Pekan 1–3 September agar alur rekap langsung terlihat.
          </p>
        </div>
      </div>
      <button type="button" onclick="promptClearDemoData()"
        class="shrink-0 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white text-xs font-semibold shadow-sm transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Kosongkan Data Contoh & Mulai Baru
      </button>
    </div>

    <!-- =================================================================== -->
    <!-- TAB 1: DASHBOARD REKAP (HALAMAN UTAMA)                              -->
    <!-- =================================================================== -->
    <section id="view-rekap" class="space-y-6 animate-fade-up">

      <!-- 4 Kartu Statistik Ringkas -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Anak Wali</span>
            <span class="p-2 rounded-xl bg-indigo-50 text-indigo-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
          </div>
          <p id="stat-total-students" class="font-display text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">0</p>
          <p class="text-xs text-slate-500 mt-1">Siswa terdaftar aktif</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Terlewat Sesi 1</span>
            <span class="p-2 rounded-xl bg-amber-50 text-amber-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <p id="stat-missed-sesi1" class="font-display text-2xl sm:text-3xl font-extrabold text-amber-600 mt-2">0</p>
          <p class="text-xs text-slate-500 mt-1">Belum susulan (Sesi 1)</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Terlewat Sesi 2</span>
            <span class="p-2 rounded-xl bg-rose-50 text-rose-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </span>
          </div>
          <p id="stat-missed-sesi2" class="font-display text-2xl sm:text-3xl font-extrabold text-rose-600 mt-2">0</p>
          <p class="text-xs text-slate-500 mt-1">Belum susulan (Sesi 2)</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Ada Tanggungan</span>
            <span class="p-2 rounded-xl bg-sky-50 text-sky-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <p id="stat-students-with-missed" class="font-display text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">0</p>
          <p id="stat-susulan-done" class="text-xs text-emerald-600 font-medium mt-1">0 susulan selesai</p>
        </div>
      </div>

      <!-- Panel Filter Interaktif -->
      <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
            <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            Filter & Pencarian Rekap
          </h2>
          <button type="button" id="btn-reset-filters" onclick="resetRekapFilters()"
            class="hidden text-xs font-semibold text-indigo-600 hover:text-indigo-800 underline underline-offset-2">
            Reset Filter
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          <!-- Pencarian Cepat -->
          <div class="lg:col-span-2 relative">
            <label for="filter-search" class="sr-only">Cari nama siswa atau mapel</label>
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="filter-search" oninput="renderRekap()"
              placeholder="Cari nama anak wali atau mapel..."
              class="w-full pl-10 pr-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 transition" />
          </div>

          <!-- Filter Nama Anak Wali -->
          <div>
            <label for="filter-student" class="sr-only">Filter Anak Wali</label>
            <select id="filter-student" onchange="renderRekap()"
              class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
              <option value="all">Semua Anak Wali</option>
            </select>
          </div>

          <!-- Filter Pekan -->
          <div>
            <label for="filter-pekan" class="sr-only">Filter Pekan</label>
            <select id="filter-pekan" onchange="renderRekap()"
              class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
              <option value="all">Semua Pekan</option>
            </select>
          </div>

          <!-- Filter Sesi & Status Tanggungan -->
          <div class="grid grid-cols-2 gap-2">
            <select id="filter-sesi" onchange="renderRekap()" aria-label="Filter Sesi"
              class="w-full px-2.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
              <option value="all">Semua Sesi</option>
              <option value="sesi1">Sesi 1</option>
              <option value="sesi2">Sesi 2</option>
            </select>

            <select id="filter-status-mode" onchange="renderRekap()" aria-label="Filter Status Tanggungan"
              class="w-full px-2.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
              <option value="all">Semua Status</option>
              <option value="missed">Ada Terlewat</option>
              <option value="clean">Aman (0)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Daftar Kartu / Tabel Rekap Otomatis per Anak Wali -->
      <div id="rekap-list-container" class="space-y-4">
        <!-- Dirender dinamis oleh JavaScript -->
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- TAB 2: INPUT PRESENSI HARIAN (SELASA, KAMIS, SABTU)                 -->
    <!-- =================================================================== -->
    <section id="view-input" class="hidden space-y-5 animate-fade-up">

      <!-- Kontrol Pemilih Tanggal & Navigasi Pekan -->
      <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
          <div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">
              Jadwal Rutin Selasa • Kamis • Sabtu
            </span>
            <h2 class="font-display text-lg font-bold text-slate-900 mt-1">
              Input Presensi Sesi 1 & Sesi 2
            </h2>
          </div>

          <!-- Navigasi Tanggal Sebelumnya / Berikutnya -->
          <div class="flex items-center gap-2">
            <button type="button" onclick="stepScheduleDate(-1)"
              class="px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-semibold flex items-center gap-1 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              Sebelumnya
            </button>
            <button type="button" onclick="stepScheduleDate(1)"
              class="px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-semibold flex items-center gap-1 transition">
              Berikutnya
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Dropdown Tanggal Dikelompokkan Per Pekan -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-end">
          <div class="lg:col-span-6">
            <label for="input-date-select" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">
              Pilih Pertemuan (Dikelompokkan Per Pekan)
            </label>
            <select id="input-date-select" onchange="onSelectInputDate()"
              class="w-full px-3.5 py-3 text-sm font-semibold text-slate-900 bg-slate-50 border border-slate-300 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
              <!-- Diisi otomatis oleh generateSchedule() -->
            </select>
          </div>

          <!-- Ubah Cepat Mapel Khusus Tanggal Terpilih -->
          <div class="lg:col-span-6 bg-slate-50 border border-slate-200/90 rounded-xl p-3">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                Mapel Tanggal Ini
                <span id="override-indicator-badge" class="hidden px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800">
                  Jadwal Khusus Tanggal Ini
                </span>
              </span>
              <button type="button" id="btn-reset-date-override" onclick="resetCurrentDateOverride()"
                class="hidden text-[11px] font-semibold text-rose-600 hover:underline">
                Kembalikan ke Template
              </button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
              <div class="sm:col-span-5">
                <label for="override-sesi1" class="sr-only">Mapel Sesi 1</label>
                <div class="relative">
                  <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-[10px] font-bold uppercase text-indigo-600 bg-indigo-50 px-1.5 py-0.5 rounded">S1</span>
                  <input type="text" id="override-sesi1" placeholder="Mapel Sesi 1"
                    class="w-full pl-10 pr-2.5 py-2 text-xs font-semibold bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500" />
                </div>
              </div>
              <div class="sm:col-span-5">
                <label for="override-sesi2" class="sr-only">Mapel Sesi 2</label>
                <div class="relative">
                  <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-[10px] font-bold uppercase text-purple-600 bg-purple-50 px-1.5 py-0.5 rounded">S2</span>
                  <input type="text" id="override-sesi2" placeholder="Mapel Sesi 2"
                    class="w-full pl-10 pr-2.5 py-2 text-xs font-semibold bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-indigo-500" />
                </div>
              </div>
              <div class="sm:col-span-2">
                <button type="button" onclick="saveCurrentDateOverride()"
                  class="w-full py-2 px-2.5 rounded-lg bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold transition">
                  Ubah
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Bar Aksi Cepat & Ringkasan Harian -->
        <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div id="daily-summary-pills" class="flex flex-wrap items-center gap-2 text-xs">
            <!-- Diisi otomatis -->
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <button type="button" onclick="markAllPresentForCurrentDate()"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white text-xs font-bold shadow-sm transition">
