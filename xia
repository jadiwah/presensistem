      const searchQuery = document.getElementById('filter-search').value.trim().toLowerCase();
      const filterStudent = document.getElementById('filter-student').value;
      const filterPekan = document.getElementById('filter-pekan').value;
      const filterSesi = document.getElementById('filter-sesi').value;
      const filterStatusMode = document.getElementById('filter-status-mode').value;

      const hasActiveFilter =
        searchQuery !== '' ||
        filterStudent !== 'all' ||
        filterPekan !== 'all' ||
        filterSesi !== 'all' ||
        filterStatusMode !== 'all';

      document.getElementById('btn-reset-filters').classList.toggle('hidden', !hasActiveFilter);

      const allRecaps = buildStudentRecapData();

      // Hitung statistik global (juga mempertimbangkan filter pekan/sesi jika dipilih)
      let globalMissedS1 = 0;
      let globalMissedS2 = 0;
      let globalStudentsWithMissed = 0;
      let globalSusulanDone = 0;

      // Filter per item & per siswa
      const filteredRecaps = allRecaps
        .filter(item => filterStudent === 'all' || item.student.id === filterStudent)
        .map(item => {
          const matchItemFilter = (rec) => {
            if (filterPekan !== 'all' && String(rec.pekan) !== filterPekan) return false;
            if (filterSesi !== 'all' && rec.sesiKey !== filterSesi) return false;
            return true;
          };

          const filteredMissed = item.activeMissed.filter(matchItemFilter);
          const filteredSusulan = item.completedSusulan.filter(matchItemFilter);

          const s1Count = filteredMissed.filter(r => r.sesiKey === 'sesi1').length;
          const s2Count = filteredMissed.filter(r => r.sesiKey === 'sesi2').length;

          return {
            student: item.student,
            missed: filteredMissed,
            susulan: filteredSusulan,
            s1Count,
            s2Count,
            totalMissed: filteredMissed.length
          };
        })
        .filter(item => {
          if (filterStatusMode === 'missed' && item.totalMissed === 0) return false;
          if (filterStatusMode === 'clean' && item.totalMissed > 0) return false;

