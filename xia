    /**
     * Tandai Susulan Selesai / Batalkan Susulan
     */
    function toggleSusulanStatus(studentId, dateStr, sesiKey, isDone) {
      if (!appState.attendance[dateStr] || !appState.attendance[dateStr][studentId]) return;
      const entry = appState.attendance[dateStr][studentId][sesiKey];
      if (!entry) return;

      entry.susulan = isDone;
      saveState();
      renderRekap();
      showToast(
        isDone
          ? 'Ditandai selesai susulan. Tanggungan otomatis berkurang.'
          : 'Status susulan dibatalkan, dikembalikan ke daftar terlewat.',
        isDone ? 'success' : 'info'
      );
    }

    /**
     * Penyusun Pesan Laporan WhatsApp Otomatis per Siswa
     */
    function buildWhatsAppMessageForStudent(studentId) {
      const filterPekan = document.getElementById('filter-pekan').value;
      const filterSesi = document.getElementById('filter-sesi').value;

      const recaps = buildStudentRecapData();
      const target = recaps.find(r => r.student.id === studentId);
      if (!target) return { phone: '', text: '' };

      const filteredMissed = target.activeMissed.filter(rec => {
        if (filterPekan !== 'all' && String(rec.pekan) !== filterPekan) return false;
        if (filterSesi !== 'all' && rec.sesiKey !== filterSesi) return false;
        return true;
      });

      const periodLabel = filterPekan !== 'all'
        ? `Pekan ${filterPekan} (${appState.settings.year})`
        : `Periode Mulai September ${appState.settings.year}`;

      let lines = [];
      lines.push(`Assalamu'alaikum / Salam sejahtera,`);
      lines.push(`Berikut informasi rekap presensi untuk Ananda *${target.student.name}* (${periodLabel}):`);
      lines.push('');

      if (filteredMissed.length === 0) {
        lines.push(`Alhamdulillah, kehadiran Ananda lengkap dan *tidak ada sesi/mapel yang terlewat*. Terima kasih atas kerja samanya.`);
      } else {
        const s1 = filteredMissed.filter(r => r.sesiKey === 'sesi1').length;
        const s2 = filteredMissed.filter(r => r.sesiKey === 'sesi2').length;

        lines.push(`*Daftar Sesi / Mapel yang Terlewat:*`);
        filteredMissed.forEach((m, index) => {
          lines.push(`${index + 1}. ${m.formattedLine}`);
        });
        lines.push('');
        lines.push(`*Total Tanggungan:* ${filteredMissed.length} Sesi (Sesi 1: ${s1}, Sesi 2: ${s2}).`);
        lines.push(`Mohon koordinasinya agar Ananda dapat segera mengikuti kelas/tugas susulan. Terima kasih.`);
      }

      return {
        phone: target.student.phone || '',
        text: lines.join('\n')
      };
    }

    function copyStudentWAMessage(studentId) {
      const { text } = buildWhatsAppMessageForStudent(studentId);
      copyTextFallback(text);
      showToast('Teks laporan WhatsApp berhasil disalin ke clipboard!', 'success');
    }

    function openWhatsAppReport(studentId) {
      const { phone, text } = buildWhatsAppMessageForStudent(studentId);
      const encodedText = encodeURIComponent(text);
      const normalizedPhone = normalizeIndonesianPhone(phone);

      const url = normalizedPhone
        ? `https://wa.me/${normalizedPhone}?text=${encodedText}`
        : `https://api.whatsapp.com/send?text=${encodedText}`;

      window.open(url, '_blank', 'noopener,noreferrer');
    }

    function normalizeIndonesianPhone(raw) {
      if (!raw) return '';
      let digits = String(raw).replace(/\D/g, '');
      if (digits.startsWith('0')) {
        digits = '62' + digits.slice(1);
      }
      return digits;
    }

    function formatPhoneDisplay(raw) {
      const digits = normalizeIndonesianPhone(raw);
      if (!digits) return raw;
      return '+' + digits;
    }

    /**
     * =========================================================================
     * TAB 2: INPUT PRESENSI HARIAN
     * =========================================================================
     */
    function renderInputDateDropdown() {
      const select = document.getElementById('input-date-select');
      select.innerHTML = '';

      // Kelompokkan jadwal berdasarkan Pekan 1, Pekan 2, dst.
      const pekanGroups = new Map();
      generatedSchedule.forEach(item => {
        if (!pekanGroups.has(item.pekan)) {
          pekanGroups.set(item.pekan, []);
        }
        pekanGroups.get(item.pekan).push(item);
      });

      pekanGroups.forEach((items, pekanNum) => {
        const optgroup = document.createElement('optgroup');
        optgroup.label = `Pekan ${pekanNum}`;

        items.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item.dateStr;
          opt.textContent = `Pekan ${item.pekan} • ${item.dayName}, ${item.displayDate} (S1: ${item.sesi1} | S2: ${item.sesi2})`;
          optgroup.appendChild(opt);
        });

        select.appendChild(optgroup);
      });

      if (selectedInputDate) {
        select.value = selectedInputDate;
      }
      syncSelectedDateOverrideInputs();
    }

    function onSelectInputDate() {
      selectedInputDate = document.getElementById('input-date-select').value;
      syncSelectedDateOverrideInputs();
      renderInputAttendanceList();
    }

    function stepScheduleDate(delta) {
      const idx = generatedSchedule.findIndex(item => item.dateStr === selectedInputDate);
      if (idx === -1) return;
      const nextIdx = idx + delta;
      if (nextIdx < 0 || nextIdx >= generatedSchedule.length) {
        showToast(delta < 0 ? 'Sudah berada di pertemuan paling awal.' : 'Sudah berada di pertemuan paling akhir.', 'info');
        return;
      }
      selectedInputDate = generatedSchedule[nextIdx].dateStr;
      document.getElementById('input-date-select').value = selectedInputDate;
      syncSelectedDateOverrideInputs();
      renderInputAttendanceList();
    }

    function syncSelectedDateOverrideInputs() {
      const sched = generatedSchedule.find(item => item.dateStr === selectedInputDate);
      if (!sched) return;

      document.getElementById('override-sesi1').value = sched.sesi1;
      document.getElementById('override-sesi2').value = sched.sesi2;

      const badge = document.getElementById('override-indicator-badge');
      const resetBtn = document.getElementById('btn-reset-date-override');
      if (sched.isOverridden) {
        badge.classList.remove('hidden');
        resetBtn.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
        resetBtn.classList.add('hidden');
      }
    }

    function saveCurrentDateOverride() {
      const s1 = document.getElementById('override-sesi1').value.trim();
      const s2 = document.getElementById('override-sesi2').value.trim();
      if (!s1 || !s2) {
        showToast('Nama Mapel Sesi 1 dan Sesi 2 tidak boleh kosong.', 'error');
        return;
      }
      appState.scheduleOverrides[selectedInputDate] = {
        sesi1: s1,
        sesi2: s2
      };
      saveState();
      generateSchedule();
      renderInputDateDropdown();
      renderInputAttendanceList();
      showToast('Mapel khusus untuk tanggal ini berhasil diperbarui!', 'success');
    }

    function resetCurrentDateOverride() {
      delete appState.scheduleOverrides[selectedInputDate];
      saveState();
      generateSchedule();
      renderInputDateDropdown();
      renderInputAttendanceList();
      showToast('Jadwal mapel tanggal ini dikembalikan ke template rutin.', 'info');
    }

    function setAttendanceStatus(studentId, sesiKey, status) {
      if (!selectedInputDate) return;
      if (!appState.attendance[selectedInputDate]) {
        appState.attendance[selectedInputDate] = {};
      }
      if (!appState.attendance[selectedInputDate][studentId]) {
        appState.attendance[selectedInputDate][studentId] = {
          sesi1: { status: '', susulan: false },
          sesi2: { status: '', susulan: false }
        };
      }

      const prevEntry = appState.attendance[selectedInputDate][studentId][sesiKey] || { status: '', susulan: false };
      // Toggle off jika mengklik status yang sama persis? Tidak, lebih aman tetap set agar tidak tidak sengaja terhapus,
      // namun jika status diubah menjadi 'Hadir', reset susulan ke false.
      appState.attendance[selectedInputDate][studentId][sesiKey] = {
        status,
        susulan: status === 'Hadir' ? false : prevEntry.susulan
      };

      saveState();
      renderInputAttendanceList();
      updateTopMissedBadgeOnly();
    }

    function markAllPresentForCurrentDate() {
      if (!selectedInputDate || appState.students.length === 0) return;
      if (!appState.attendance[selectedInputDate]) {
        appState.attendance[selectedInputDate] = {};
      }

      appState.students.forEach(stu => {
        appState.attendance[selectedInputDate][stu.id] = {
          sesi1: { status: 'Hadir', susulan: false },
          sesi2: { status: 'Hadir', susulan: false }
        };
      });

      saveState();
      renderInputAttendanceList();
      updateTopMissedBadgeOnly();
      showToast('Seluruh anak wali pada tanggal ini ditandai HADIR (Sesi 1 & 2).', 'success');
    }

    function updateTopMissedBadgeOnly() {
      const allRecaps = buildStudentRecapData();
      const totalAllActiveMissed = allRecaps.reduce((acc, cur) => acc + cur.activeMissed.length, 0);
      document.getElementById('nav-badge-missed').textContent = totalAllActiveMissed;
