    /**
     * Load & Save State ke localStorage
     */
    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) {
          const demo = createInitialDemoState();
          localStorage.setItem(STORAGE_KEY, JSON.stringify(demo));
          return demo;
        }
        const parsed = JSON.parse(raw);
        // Pastikan properti wajib tersedia
        if (!parsed.settings) parsed.settings = { year: 2026, monthsCount: 4, templates: {} };
        if (!parsed.settings.templates) {
          parsed.settings.templates = {
            2: { sesi1: 'Matematika', sesi2: 'Fisika' },
            4: { sesi1: 'Kimia', sesi2: 'Biologi' },
            6: { sesi1: 'Penalaran Umum', sesi2: 'Bahasa Inggris' }
          };
        }
        if (!Array.isArray(parsed.students)) parsed.students = [];
        if (!parsed.scheduleOverrides) parsed.scheduleOverrides = {};
        if (!parsed.attendance) parsed.attendance = {};
        return parsed;
      } catch (err) {
        console.error('Gagal membaca localStorage:', err);
        return createInitialDemoState();
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
        flashSaveBadge();
      } catch (err) {
        console.error('Gagal menyimpan ke localStorage:', err);
        showToast('Gagal menyimpan perubahan ke browser.', 'error');
      }
    }

    function flashSaveBadge() {
      const badges = [document.getElementById('save-badge-mobile'), document.getElementById('save-badge-desktop')];
      badges.forEach(el => {
        if (!el) return;
        el.classList.add('ring-2', 'ring-emerald-400');
        setTimeout(() => el.classList.remove('ring-2', 'ring-emerald-400'), 450);
      });
    }

    /**
     * 1. GENERASI JADWAL OTOMATIS (SELASA, KAMIS, SABTU MULAI SEPTEMBER)
     * Pengelompokan Pekan konsisten berdasarkan minggu kalender (Senin-Minggu):
     * Contoh: 1 Sep 2026 (Selasa), 3 Sep (Kamis), 5 Sep (Sabtu) = Pekan 1
     *         8 Sep 2026 (Selasa), 10 Sep (Kamis), 12 Sep (Sabtu) = Pekan 2
     */
    function getMondayOfWeek(dateObj) {
      const d = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate());
      const day = d.getDay(); // 0 = Minggu, 1 = Senin, ..., 6 = Sabtu
      const diffToMonday = day === 0 ? -6 : 1 - day;
      d.setDate(d.getDate() + diffToMonday);
      d.setHours(0, 0, 0, 0);
      return d;
    }

    function formatYYYYMMDD(dateObj) {
      const y = dateObj.getFullYear();
      const m = String(dateObj.getMonth() + 1).padStart(2, '0');
      const d = String(dateObj.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    function formatDisplayDateID(dateObj) {
      const d = String(dateObj.getDate()).padStart(2, '0');
      const m = MONTH_NAMES_SHORT_ID[dateObj.getMonth()];
      const y = dateObj.getFullYear();
      return `${d} ${m} ${y}`;
    }

    function generateSchedule() {
      const year = Number(appState.settings.year) || 2026;
      const monthsCount = Number(appState.settings.monthsCount) || 4;
      const templates = appState.settings.templates;
      const overrides = appState.scheduleOverrides || {};

      // Jangkar pekan pertama: Senin pada minggu tanggal 1 September
      const septFirst = new Date(year, 8, 1); // Bulan ke-8 = September (0-indexed)
      const week1Monday = getMondayOfWeek(septFirst);
      const msPerWeek = 7 * 24 * 60 * 60 * 1000;

      const list = [];
      for (let mOffset = 0; mOffset < monthsCount; mOffset++) {
        const currentMonthDate = new Date(year, 8 + mOffset, 1);
        const curYear = currentMonthDate.getFullYear();
        const curMonth = currentMonthDate.getMonth();
        const daysInMonth = new Date(curYear, curMonth + 1, 0).getDate();

        for (let day = 1; day <= daysInMonth; day++) {
          const dateObj = new Date(curYear, curMonth, day);
          const dow = dateObj.getDay();

          // Hanya hari Selasa (2), Kamis (4), Sabtu (6)
          if (dow === 2 || dow === 4 || dow === 6) {
            const currentMonday = getMondayOfWeek(dateObj);
            const pekanNum = Math.round((currentMonday.getTime() - week1Monday.getTime()) / msPerWeek) + 1;
            const dateStr = formatYYYYMMDD(dateObj);
            const dayName = DAY_NAMES_ID[dow];
            const displayDate = formatDisplayDateID(dateObj);

            const tpl = templates[dow] || { sesi1: 'Sesi 1', sesi2: 'Sesi 2' };
            const ov = overrides[dateStr];

            list.push({
              dateStr,
              dateObj,
              dow,
              dayName,
              displayDate,
              pekan: pekanNum,
              pekanLabel: `Pekan ${pekanNum}`,
              sesi1: ov && ov.sesi1 ? ov.sesi1 : tpl.sesi1,
              sesi2: ov && ov.sesi2 ? ov.sesi2 : tpl.sesi2,
              isOverridden: Boolean(ov)
            });
          }
        }
      }

      generatedSchedule = list;

      // Update label periode pada header
      const maxPekan = list.length > 0 ? list[list.length - 1].pekan : 0;
      const lastItem = list[list.length - 1];
      const endMonthName = lastItem ? MONTH_NAMES_SHORT_ID[lastItem.dateObj.getMonth()] : 'Des';
      document.getElementById('header-period-subtitle').textContent =
        `Selasa, Kamis, Sabtu • Sep – ${endMonthName} ${year}`;
      document.getElementById('header-schedule-pill').textContent =
        `${maxPekan} Pekan • ${list.length} Pertemuan`;

      // Pastikan selectedInputDate valid
      if (!selectedInputDate || !list.some(item => item.dateStr === selectedInputDate)) {
        selectedInputDate = list.length > 0 ? list[0].dateStr : '';
      }
    }

    /**
     * Navigasi Antar 3 Tab Utama
     */
    function switchTab(tabName) {
      currentTab = tabName;
      const tabs = ['rekap', 'input', 'settings'];
      tabs.forEach(t => {
        const viewEl = document.getElementById(`view-${t}`);
        const btnEl = document.getElementById(`tab-btn-${t}`);
        if (t === tabName) {
          viewEl.classList.remove('hidden');
          btnEl.classList.remove('tab-inactive');
          btnEl.classList.add('tab-active');
        } else {
          viewEl.classList.add('hidden');
          btnEl.classList.remove('tab-active');
          btnEl.classList.add('tab-inactive');
        }
      });

      if (tabName === 'rekap') {
        populateRekapFilters();
        renderRekap();
      } else if (tabName === 'input') {
        renderInputDateDropdown();
        renderInputAttendanceList();
      } else if (tabName === 'settings') {
        renderSettingsTab();
      }
    }

    /**
     * Mengumpulkan data rekap ketidakhadiran setiap anak wali
     */
    function buildStudentRecapData() {
      const scheduleMap = new Map();
      generatedSchedule.forEach(item => scheduleMap.set(item.dateStr, item));

      const recaps = appState.students.map(student => {
        const activeMissed = []; // Terlewat yang belum susulan
        const completedSusulan = []; // Terlewat yang sudah susulan

        generatedSchedule.forEach(sched => {
          const dateLog = appState.attendance[sched.dateStr];
          if (!dateLog || !dateLog[student.id]) return;

          const stuLog = dateLog[student.id];

          ['sesi1', 'sesi2'].forEach(sesiKey => {
            const entry = stuLog[sesiKey];
            if (!entry || !entry.status || entry.status === 'Hadir') return;

            const sesiNum = sesiKey === 'sesi1' ? 1 : 2;
            const mapelName = sesiKey === 'sesi1' ? sched.sesi1 : sched.sesi2;
            const formattedLine = `[${sched.pekanLabel} • ${sched.dayName}, ${sched.displayDate}] | Sesi ${sesiNum} - ${mapelName} (Status: ${entry.status})`;

            const recordObj = {
              dateStr: sched.dateStr,
              pekan: sched.pekan,
              pekanLabel: sched.pekanLabel,
              dayName: sched.dayName,
              displayDate: sched.displayDate,
              sesiKey,
              sesiNum,
              mapel: mapelName,
              status: entry.status,
              susulan: Boolean(entry.susulan),
              formattedLine
            };

            if (recordObj.susulan) {
              completedSusulan.push(recordObj);
            } else {
              activeMissed.push(recordObj);
            }
          });
        });

        return {
          student,
          activeMissed,
          completedSusulan
        };
      });

      return recaps;
    }

    /**
     * =========================================================================
     * TAB 1: DASHBOARD REKAP
     * =========================================================================
     */
    function populateRekapFilters() {
      const stuSelect = document.getElementById('filter-student');
      const currentStuVal = stuSelect.value;
      stuSelect.innerHTML = '<option value="all">Semua Anak Wali</option>';
      appState.students.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.name;
        stuSelect.appendChild(opt);
      });
      if ([...stuSelect.options].some(o => o.value === currentStuVal)) {
        stuSelect.value = currentStuVal;
      }

      const pekanSelect = document.getElementById('filter-pekan');
      const currentPekanVal = pekanSelect.value;
      pekanSelect.innerHTML = '<option value="all">Semua Pekan</option>';
      const uniquePekans = [...new Set(generatedSchedule.map(s => s.pekan))];
      uniquePekans.forEach(p => {
        const opt = document.createElement('option');
        opt.value = String(p);
        opt.textContent = `Pekan ${p}`;
        pekanSelect.appendChild(opt);
      });
      if ([...pekanSelect.options].some(o => o.value === currentPekanVal)) {
        pekanSelect.value = currentPekanVal;
      }
    }

